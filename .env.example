# ════════════════════════════════════════════════════════════
#  AZ FINDS + MAXIMUS  ·  Unified Environment
#  Copy:  cp .env.example .env   then fill in your keys.
#  ⚠ NEVER commit .env — gitignored at every level.
#  Production: set keys in Netlify → Site Settings → Env Vars.
# ════════════════════════════════════════════════════════════

# ── Anthropic (required for MAXIMUS AI chat & agent pipeline) ──
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-

# ── RetailerAPI — live ASIN price/fee lookup (free tier) ──
# https://www.retailerapi.com
RETAILERAPI_KEY=

# ── Daily Briefing Agent (macOS only) ──
IMESSAGE_RECIPIENT=
DRY_RUN=false

# ── Server ports ──
MAXIMUS_PORT=3001

# ─────────────────────────────────────────────────────────────
#  MCP Server — optional live data sources
#  All keys below are optional. Without them the server uses
#  estimate-engine mode and clearly labels confidence levels.
# ─────────────────────────────────────────────────────────────

# Keepa (price/BSR history). https://keepa.com/#!api
KEEPA_API_KEY=

# Amazon Product Advertising API (PA-API 5.0)
AMAZON_PA_API_KEY=
AMAZON_PA_SECRET=
AMAZON_ASSOCIATE_TAG=

# Web search providers (used for product + supplier discovery)
SERPAPI_KEY=
BING_SEARCH_API_KEY=

# Google Trends (public, best-effort; set to "true" to attempt)
GOOGLE_TRENDS_ENABLED=false

# Real product images (optional). Without these, premium category illustrations are used.
# Pexels: free key at https://www.pexels.com/api/ — representative product photos (not exact SKU).
PEXELS_API_KEY=
# Openverse commercial-CC fallback (best-effort, lower relevance). Set "true" to attempt.
OPENVERSE_ENABLED=false

# Defaults
DEFAULT_MARKETPLACE=US
DEFAULT_CURRENCY=USD
CACHE_TTL_HOURS=24
MAX_SEARCH_RESULTS=50

# SP-API (Amazon Selling Partner API)
SP_API_REFRESH_TOKEN=
SP_API_CLIENT_ID=
SP_API_CLIENT_SECRET=
SP_API_MARKETPLACE_ID=ATVPDKIKX0DER

# Amazon Advertising API
ADS_CLIENT_ID=
ADS_CLIENT_SECRET=
ADS_REFRESH_TOKEN=
ADS_PROFILE_ID=

# Push Notifications
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1...
SELLER_PHONE_NUMBER=+1...
SENDGRID_API_KEY=
SELLER_EMAIL=

# Team Auth (generate with: openssl rand -hex 32)
JWT_SECRET=change-this-to-a-long-random-string
