# ─── Amazon Seller Product Research MCP — environment ───
# All keys are OPTIONAL. With no keys the server runs in MOCK mode and clearly
# labels every estimate as low/medium confidence. Add keys to enable REAL mode.

# Keepa (price/BSR history). https://keepa.com/#!api
KEEPA_API_KEY=

# Amazon Product Advertising API (PA-API 5.0)
AMAZON_PA_API_KEY=
AMAZON_PA_SECRET=
AMAZON_ASSOCIATE_TAG=

# Web search providers (used for product + supplier discovery)
SERPAPI_KEY=
BING_SEARCH_API_KEY=

# Google Trends (public, best-effort; set to "true" to attempt)
GOOGLE_TRENDS_ENABLED=false

# Real product images (optional). Without these, premium category illustrations are used.
# Pexels: free key at https://www.pexels.com/api/ — representative product photos (not exact SKU).
PEXELS_API_KEY=
# Openverse commercial-CC fallback (best-effort, lower relevance). Set "true" to attempt.
OPENVERSE_ENABLED=false

# Defaults
DEFAULT_MARKETPLACE=US
DEFAULT_CURRENCY=USD
CACHE_TTL_HOURS=24
MAX_SEARCH_RESULTS=50
