{
  "name": "amazon-seller-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "MCP server for ethical, citation-backed Amazon FBA/FBM generic product research.",
  "type": "module",
  "bin": {
    "amazon-seller-mcp": "dist/index.js"
  },
  "scripts": {
    "build":       "tsc -p tsconfig.json",
    "start":       "node dist/index.js",
    "dev":         "tsc -w -p tsconfig.json",
    "http":        "node dist/http.js",
    "dev:http":    "tsx src/http.ts",
    "research:sample": "node dist/cli/sample.js",
    "research:daily": "node dist/cli/daily.js",
    "research:top50": "node dist/cli/top50.js",
    "images:enrich": "node dist/cli/enrichImages.js",
    "sources:status": "node dist/cli/sourcesStatus.js",
    "research:top5log": "node dist/cli/top5log.js",
    "price:asin": "node dist/cli/priceAsin.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk":         "^0.52.0",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "cors":                      "^2.8.5",
    "dotenv":                    "^16.4.5",
    "express":                   "^4.21.2",
    "zod":                       "^3.23.8"
  },
  "devDependencies": {
    "@types/cors":    "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node":    "^22.7.5",
    "tsx":            "^4.19.0",
    "typescript":     "^5.6.3"
  },
  "engines": {
    "node": ">=18"
  }
}
