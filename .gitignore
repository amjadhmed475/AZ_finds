# ════════════════════════════════════════════════════════════
#  AZ FINDS + MAXIMUS  ·  .gitignore
# ════════════════════════════════════════════════════════════

# ── Dependencies & build output ──────────────────────────────
node_modules/
dist/
*.tsbuildinfo

# ── API KEYS — NEVER COMMIT ANY .env FILE ───────────────────
# Root
.env
.env.local
.env.*.local

# Nested packages
agents/.env
agents/.env.local
server/.env
server/.env.local
artifact/app/.env
artifact/app/.env.local

# Catch-all for any future subdirectory
**/.env
**/.env.local
**/.env.*.local

# Always track example files
!.env.example
!**/.env.example

# ── Runtime data (regenerated by CLI/server) ─────────────────
server/data/batches/
server/data/images/
reports/

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/*.json

# ── Agent runtime ─────────────────────────────────────────────
agents/node_modules/

# ── Misc ──────────────────────────────────────────────────────
AZ_Finds_Daily_Top5.csv
.DS_Store
.netlify/
.vscode/
Thumbs.db
