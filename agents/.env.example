# ─── YAMARI GROUP INTELLIGENCE DIVISION ───────────────────────
# Copy to .env and fill in your values before first run.

# Anthropic API key — required for Maximus & Herald agents
# Get yours at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# iMessage recipient — your phone number or iCloud email
# Format: +1XXXXXXXXXX  OR  yourname@icloud.com
IMESSAGE_RECIPIENT=+1XXXXXXXXXX

# Path to the AZ Finds project root (defaults to parent directory)
AZ_FINDS_ROOT=..

# Set to 'true' to skip actual iMessage send (print to console instead)
DRY_RUN=false

# Which model powers each agent (defaults shown)
# ORCHESTRATOR_MODEL=claude-opus-4-8
# MAXIMUS_MODEL=claude-sonnet-4-6
# HERALD_MODEL=claude-haiku-4-5-20251001
